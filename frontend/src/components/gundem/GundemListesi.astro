---
// Gündem gönderilerinin filtrelenebilir listesi. Ana sayfada ve /gundem arşivinde kullanılır.
// Filtre düğmeleri JavaScript ile açılır; JS kapalıysa liste yine eksiksiz okunur.
// yilaGore verilirse (arşiv sayfası) gönderiler yıl başlıkları altında gruplanır.
import { ETIKETLER, type Gonderi } from '../../lib/gundem';
import { etkinlikZamani, isoTarih, kisaTarih, yil } from '../../lib/tarih';

interface Props {
  gonderiler: Gonderi[];
  yilaGore?: boolean;
}
const { gonderiler, yilaGore = false } = Astro.props;
const filtreler = ['Tümü', ...ETIKETLER];

// Gönderiler zaten en yeni önce sıralı geldiği için gruplar da yeniden eskiye dizilir.
const gruplar: { yil: number | null; gonderiler: Gonderi[] }[] = [];
for (const g of gonderiler) {
  const y = yilaGore ? yil(g.data.tarih) : null;
  const son = gruplar.at(-1);
  if (son && son.yil === y) son.gonderiler.push(g);
  else gruplar.push({ yil: y, gonderiler: [g] });
}
---

<div data-gundem>
  <div class="filters" role="group" aria-label="Gündemi filtrele" data-filtreler hidden>
    {filtreler.map((f) => (
      <button
        type="button"
        class="filter"
        data-filtre={f}
        aria-pressed={f === 'Tümü' ? 'true' : 'false'}
      >
        {f}
      </button>
    ))}
  </div>

  <div class="list">
    {gruplar.map((grup) => (
      <section
        class="year-group"
        data-yil-grubu
        aria-labelledby={grup.yil ? `yil-${grup.yil}` : undefined}
      >
        {grup.yil && (
          <h2 class="year-title" id={`yil-${grup.yil}`}>
            {grup.yil}
          </h2>
        )}
        {grup.gonderiler.map((g) => {
          const etkinlik = g.data.etiket === 'Etkinlik' ? g.data.etkinlik : undefined;
          return (
            <article class="row" data-etiket={g.data.etiket}>
              <div class="row-meta">
                <time datetime={isoTarih(g.data.tarih)}>{kisaTarih(g.data.tarih)}</time>
              </div>
              <div class="row-body">
                <span class:list={['chip', { event: g.data.etiket === 'Etkinlik' }]}>
                  {g.data.etiket}
                </span>
                <h3 class="post-title">
                  <a href={`/gundem/${g.id}/`}>{g.data.baslik}</a>
                </h3>
                <p class="post-summary">{g.data.ozet}</p>
                {etkinlik && (
                  <div class="event-meta">
                    <span>
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M16 3v4M8 3v4M3 10h18" />
                      </svg>
                      <time datetime={isoTarih(etkinlik.zaman)}>
                        {etkinlikZamani(etkinlik.zaman)}
                      </time>
                    </span>
                    <span>
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" />
                        <circle cx="12" cy="10" r="2.5" />
                      </svg>
                      {etkinlik.yer}
                    </span>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </section>
    ))}
    <p class="empty" data-bos hidden>
      Bu etikette henüz gönderi yok.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gundem]').forEach((kok) => {
    const grup = kok.querySelector<HTMLElement>('[data-filtreler]');
    const satirlar = kok.querySelectorAll<HTMLElement>('[data-etiket]');
    const yilGruplari = kok.querySelectorAll<HTMLElement>('[data-yil-grubu]');
    const bos = kok.querySelector<HTMLElement>('[data-bos]');
    if (!grup) return;
    grup.hidden = false;

    grup.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filtre]');
      if (!btn) return;
      const secili = btn.dataset.filtre;
      grup
        .querySelectorAll('[data-filtre]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let gorunen = 0;
      satirlar.forEach((s) => {
        const goster = secili === 'Tümü' || s.dataset.etiket === secili;
        s.hidden = !goster;
        if (goster) gorunen++;
      });
      // Seçili etikette gönderisi kalmayan yılın başlığı da gizlenir.
      yilGruplari.forEach((y) => {
        y.hidden = !y.querySelector('[data-etiket]:not([hidden])');
      });
      if (bos) bos.hidden = gorunen > 0;
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 12px;
  }
  .filter {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--navy);
    border-radius: 22px;
    font: 500 14px var(--sans);
    cursor: pointer;
  }
  .filter:hover {
    border-color: var(--navy);
  }
  .filter[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--paper);
  }
  .year-title {
    margin: 40px 0 0;
    padding-bottom: 12px;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.2;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }
  .year-group:first-child .year-title {
    margin-top: 8px;
  }
  .post-title {
    margin: 10px 0 0;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.3;
  }
  .post-title a {
    text-decoration: none;
  }
  .post-summary {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text);
    max-width: 680px;
  }
  .event-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 14px;
    padding: 10px 14px;
    background: var(--tint);
    border-radius: var(--radius);
    font-size: 14px;
    color: var(--navy);
  }
  .event-meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .empty {
    padding-block: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
</style>
