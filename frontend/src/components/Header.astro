---
// Üst menü. Aşağı kaydırınca gizlenir, yukarı kaydırınca geri gelir.
// 900px altında bağlantılar menü düğmesine toplanır.
import Logo from './Logo.astro';
import { menu, site, type Sayfa } from '../config/site';

interface Props {
  sayfa: Sayfa;
}
const { sayfa } = Astro.props;
const aktifMi = (s: string | null) => s !== null && s === sayfa;
---

<header class="site-header" data-header>
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label={`${site.kisaAd} ana sayfa`}>
      <Logo />
      <span class="brand-text">
        <span class="brand-name">{site.kisaAd}</span>
        <span class="brand-sub">{site.universite}</span>
      </span>
    </a>

    <div class="header-right">
      <nav class="nav-desktop" aria-label="Ana menü">
        {menu.map((m) => (
          <a href={m.href} aria-current={aktifMi(m.sayfa) ? 'page' : undefined}>
            {m.ad}
          </a>
        ))}
        <a href="/#uyelik" class="btn btn-primary">
          Üye ol
        </a>
      </nav>

      <div class="inst-logos">
        {site.kurumlar.map((k) => (
          <a
            href={k.url}
            aria-label={k.ad}
            target={k.url.startsWith('http') ? '_blank' : undefined}
            rel="noopener"
          >
            {k.logo ? (
              <img src={k.logo} alt="" width="40" height="40" />
            ) : (
              <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
                <circle
                  cx="20"
                  cy="20"
                  r="19"
                  fill="var(--tint)"
                  stroke="var(--placeholder)"
                  stroke-dasharray="3 3"
                />
                <text
                  x="20"
                  y="24"
                  text-anchor="middle"
                  font-family="IBM Plex Mono, monospace"
                  font-size="10"
                  fill="var(--muted)"
                >
                  {k.kisa}
                </text>
              </svg>
            )}
          </a>
        ))}
      </div>

      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Menüyü aç"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav class="nav-mobile wrap" id="nav-mobile" aria-label="Mobil menü" hidden>
    {menu.map((m) => (
      <a href={m.href} aria-current={aktifMi(m.sayfa) ? 'page' : undefined}>
        {m.ad}
      </a>
    ))}
    <a href="/#uyelik" class="btn btn-primary">
      Üye ol
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobile = document.getElementById('nav-mobile');

  if (header && toggle && mobile) {
    const setMenu = (open: boolean) => {
      mobile.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
      if (open) header.classList.remove('is-hidden');
    };
    toggle.addEventListener('click', () => setMenu(Boolean(mobile.hidden)));
    mobile.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setMenu(false);
    });

    // Aşağı kaydırınca gizle, en az 8px yukarı kaydırınca göster.
    let last = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const d = y - last;
        if (y < 80) {
          header.classList.remove('is-hidden');
          last = y;
          return;
        }
        if (d > 8) {
          if (mobile.hidden) header.classList.add('is-hidden');
          last = y;
        } else if (d < -8) {
          header.classList.remove('is-hidden');
          last = y;
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    transition: transform 240ms ease;
  }
  .site-header.is-hidden {
    transform: translateY(calc(-100% - env(safe-area-inset-top, 0px)));
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--navy);
  }
  .brand:hover {
    color: var(--navy);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-weight: 600;
    font-size: 20px;
    letter-spacing: 0.04em;
  }
  .brand-sub {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 15px;
  }
  .nav-desktop a:not(.btn) {
    text-decoration: none;
    padding: 10px 0;
  }
  .nav-desktop a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    text-decoration-color: var(--accent);
  }
  .nav-desktop .btn {
    min-height: 44px;
    padding: 0 18px;
  }
  .inst-logos {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .inst-logos a {
    display: inline-flex;
  }
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--navy);
    cursor: pointer;
  }
  .nav-mobile {
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    padding-block: 8px 20px;
    font-size: 16px;
  }
  .nav-mobile a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 48px;
    text-decoration: none;
    border-bottom: 1px solid var(--chip);
  }
  .nav-mobile a[aria-current='page'] {
    font-weight: 600;
  }
  .nav-mobile .btn {
    margin-top: 12px;
  }

  @media (max-width: 900px) {
    .nav-desktop {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 560px) {
    .inst-logos {
      padding-left: 12px;
      gap: 6px;
    }
    .header-right {
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
