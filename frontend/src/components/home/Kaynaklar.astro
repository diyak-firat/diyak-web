---
import KaynakSatiri from '../kaynaklar/KaynakSatiri.astro';
import { kaynaklar } from '../../lib/kaynaklar';

const ANA_SAYFADA_GOSTERILEN = 5;
const ilkler = (await kaynaklar()).slice(0, ANA_SAYFADA_GOSTERILEN);
---

<section class="band kaynaklar" id="kaynaklar" aria-labelledby="kaynaklar-baslik">
  <div class="wrap">
    <div class="section-head head">
      <h2 class="h2" id="kaynaklar-baslik">
        Yayınlar ve açık kaynaklar
      </h2>
      <a href="/kaynaklar/">Tüm yayınlar ve kaynaklar →</a>
    </div>
    <div class="list">
      {ilkler.map((k) => (
        <KaynakSatiri kaynak={k} />
      ))}
    </div>
  </div>
</section>

<style>
  .kaynaklar {
    border-top: 0;
  }
  .kaynaklar > .wrap {
    padding-bottom: 72px;
  }
  .head {
    margin-bottom: 20px;
  }
</style>
