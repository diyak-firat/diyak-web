---
import { site } from '../config/site';
import { ekip } from '../lib/ekip';

const yil = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-about">
        <strong>{site.kisaAd}</strong>
        {site.resmiAd}
        <br />
        {site.bagliBirim}
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <span class="head">Topluluk</span>
          <a href="/#hakkimizda">Hakkımızda</a>
          <a href="/gundem/">Gündem</a>
          <a href="/ekip/">Ekip</a>
          <a href={site.belgeler.tuzuk}>Tüzük</a>
        </div>
        <div class="footer-col">
          <span class="head">Bizi takip edin</span>
          {site.sosyal.map((s) => (
            <a href={s.url}>{s.ad}</a>
          ))}
        </div>
        <div class="footer-col">
          <span class="head">İletişim</span>
          <a href={`mailto:${site.eposta}`}>{site.eposta}</a>
          <span>
            Akademik Danışman:
            <br />
            {ekip.danisman.ad}
          </span>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>
        © {yil} {site.kisaAd}
      </span>
      <span class="dash" aria-hidden="true">
        <i class="dash-long"></i>
        <i class="dash-short"></i>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-3);
    color: var(--on-navy);
  }
  .site-footer > .wrap {
    padding-block: 56px 32px;
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    justify-content: space-between;
  }
  .footer-about {
    flex: 1 1 300px;
    min-width: 0;
    font-size: 14px;
    line-height: 1.6;
  }
  .footer-about strong {
    display: block;
    color: var(--paper);
    font-size: 18px;
    margin-bottom: 8px;
  }
  .footer-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 56px;
    font-size: 14px;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col .head {
    color: var(--paper);
    font-weight: 600;
  }
  .footer-col a {
    color: var(--on-navy);
  }
  .footer-col a:hover {
    color: var(--paper);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--navy-line);
    font-size: 13px;
  }
  .dash {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .dash i {
    display: block;
    height: 4px;
    border-radius: 2px;
  }
  .dash-long {
    width: 28px;
    background: var(--on-navy);
  }
  .dash-short {
    width: 10px;
    background: var(--accent);
  }
</style>
