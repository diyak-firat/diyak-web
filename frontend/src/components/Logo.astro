---
// DİYAK logosu: altı satırlık çizgi motifi "D" harfini oluşturur.
// Ölçüler DIYAK_profil_lacivert_zemin.png referansından alındı (çubuk yüksekliği = 10 birim).
interface Props {
  boyut?: number;
  /** Koyu zemin için açık renkli sürüm */
  acik?: boolean;
}
const { boyut = 44, acik = false } = Astro.props;
const renk = acik ? 'var(--on-navy)' : 'var(--navy)';

// [x, y, genişlik]
const cubuklar: [number, number, number][] = [
  [0, 0, 40],
  [44, 0, 40],
  [0, 20, 28],
  [62, 20, 40],
  [0, 40, 28],
  [76, 40, 34],
  [0, 60, 28],
  [76, 60, 34],
  [0, 80, 28],
  [62, 80, 40],
  [0, 100, 58],
];
---

<svg width={boyut} height={boyut} viewBox="0 0 110 110" aria-hidden="true">
  {cubuklar.map(([x, y, w]) => (
    <rect x={x} y={y} width={w} height="10" rx="5" fill={renk} />
  ))}
  <rect x="62" y="100" width="22" height="10" rx="5" fill="var(--accent)" />
</svg>
