# Yerel geliştirme için: bu dosyayı .env olarak kopyalayın (cp .env.example .env).
# .env repoya girmez. Sunucudaki .env ayrıdır ve COMPOSE_FILE satırını İÇERMEZ.

# Yerel geliştirme eklentisini otomatik ekle
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Konteynerde oluşan dosyaların sahibi (Linux'ta `id -u` ve `id -g`)
DIYAK_UID=1000
DIYAK_GID=1000

# Sunucuda doldurulur (yerelde gerekmez):
# DJANGO_ALLOWED_HOSTS=panel.ornek.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://panel.ornek.org
